research_task:
  description: >
    Research {topic} thoroughly as of {current_year}. Collect key facts,
    recent developments, notable players and any data points. Note sources.
  expected_output: >
    A bulleted list of at least 10 findings, each with a short source note.
  agent: researcher

analysis_task:
  description: >
    Review the research on {topic}. Identify the main insights, trends,
    risks, contradictions and open questions.
  expected_output: >
    A structured analysis with sections: Key Insights, Trends, Risks,
    Open Questions.
  agent: analyst

report_task:
  description: >
    Write a final report on {topic} using the research and analysis. Use the
    word counter tool to confirm the report is between 600 and 900 words.
  expected_output: >
    A Markdown report with a title, executive summary, main sections and a
    conclusion. Do not wrap it in code fences.
  agent: writer
  output_file: output/report.md
