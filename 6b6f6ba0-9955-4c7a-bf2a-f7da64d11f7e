import argparse
import os
from datetime import datetime

from dotenv import load_dotenv

from research_crew.crew import ResearchCrew


def main() -> None:
    load_dotenv()
    parser = argparse.ArgumentParser(description="Run the CrewAI research crew.")
    parser.add_argument("--topic", required=True, help="Topic to research")
    args = parser.parse_args()

    if not os.getenv("OPENAI_API_KEY") and not os.getenv("MODEL"):
        raise SystemExit("Set OPENAI_API_KEY (or MODEL plus its provider key) in .env")

    os.makedirs("output", exist_ok=True)
    result = ResearchCrew().crew().kickoff(
        inputs={"topic": args.topic, "current_year": str(datetime.now().year)}
    )
    print("\n=== FINAL REPORT ===\n")
    print(result.raw)
    print("\nSaved to output/report.md")


if __name__ == "__main__":
    main()
